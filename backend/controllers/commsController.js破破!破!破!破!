const db = require('../db/connection');
const nodemailer = require('nodemailer');

// Helper to get SMTP transport
const getTransport = async () => {
    const smtp = db.prepare("SELECT * FROM comms_settings_smtp ORDER BY id DESC LIMIT 1").get();
    if (!smtp || !smtp.host) return null;

    return nodemailer.createTransport({
        host: smtp.host,
        port: smtp.port,
        secure: smtp.secure === 1,
        auth: {
            user: smtp.user,
            pass: smtp.pass
        }
    });
};

// Helper to replace placeholders
const processTemplate = (text, data) => {
    let result = text;
    Object.keys(data).forEach(key => {
        const regex = new RegExp(`{{${key}}}`, 'g');
        result = result.replace(regex, data[key] || '');
    });
    return result;
};

exports.getSettings = (req, res) => {
    try {
        const smtp = db.prepare("SELECT * FROM comms_settings_smtp ORDER BY id DESC LIMIT 1").get() || {
            host: '', port: 587, user: '', pass: '', secure: 0, from_name: '', from_email: ''
        };
        const templates = db.prepare("SELECT * FROM comms_templates").all();
        res.json({ smtp, templates });
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
};

exports.saveSmtp = (req, res) => {
    const { host, port, user, pass, secure, from_name, from_email } = req.body;
    try {
        const existing = db.prepare("SELECT id FROM comms_settings_smtp LIMIT 1").get();
        if (existing) {
            db.prepare(`
                UPDATE comms_settings_smtp 
                SET host=?, port=?, user=?, pass=?, secure=?, from_name=?, from_email=? 
                WHERE id=?
            `).run(host, port, user, pass, secure ? 1 : 0, from_name, from_email, existing.id);
        } else {
            db.prepare(`
                INSERT INTO comms_settings_smtp (host, port, user, pass, secure, from_name, from_email) 
                VALUES (?, ?, ?, ?, ?, ?, ?)
            `).run(host, port, user, pass, secure ? 1 : 0, from_name, from_email);
        }
        res.json({ success: true });
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
};

exports.saveTemplate = (req, res) => {
    const { type, subject, body } = req.body;
    try {
        db.prepare("UPDATE comms_templates SET subject=?, body=? WHERE type=?").run(subject, body, type);
        res.json({ success: true });
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
};

exports.sendEmail = async (req, res) => {
    const { type, recipientId, contextData, attachments } = req.body;
    // contextData: { client_name, reference, studio_name, ... }

    try {
        const template = db.prepare("SELECT * FROM comms_templates WHERE type=?").get();
        if (!template) return res.status(404).json({ error: "Modèle non trouvé" });

        const smtp = db.prepare("SELECT * FROM comms_settings_smtp ORDER BY id DESC LIMIT 1").get();
        const transport = await getTransport();
        if (!transport) return res.status(400).json({ error: "Serveur SMTP non configuré" });

        const client = db.prepare("SELECT * FROM clients WHERE id=?").get(recipientId);
        if (!client || !client.email) return res.status(400).json({ error: "Email du client manquant" });

        const subject = processTemplate(template.subject, contextData);
        const body = processTemplate(template.body, contextData);

        const mailOptions = {
            from: `"${smtp.from_name || 'Studio'}" <${smtp.from_email || smtp.user}>`,
            to: client.email,
            subject: subject,
            text: body,
            html: body.replace(/\n/g, '<br/>'),
            attachments: attachments || []
        };

        const info = await transport.sendMail(mailOptions);

        // Log communication
        db.prepare(`
            INSERT INTO comms_log (client_id, type, recipient, subject, body, status) 
            VALUES (?, 'email', ?, ?, ?, 'sent')
        `).run(recipientId, client.email, subject, body);

        res.json({ success: true, messageId: info.messageId });
    } catch (err) {
        console.error('Send Email Error:', err);
        res.status(500).json({ error: err.message });
    }
};

exports.getLogs = (req, res) => {
    try {
        const logs = db.prepare(`
            SELECT l.*, c.name as client_name 
            FROM comms_log l 
            LEFT JOIN clients c ON l.client_id = c.id 
            ORDER BY sent_at DESC LIMIT 50
        `).all();
        res.json(logs);
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
};
